# Cirix Tech Platform — environment variables
# Copy this file to `.env.local` (git-ignored) and fill in the real values.
# NEVER commit `.env.local` or the Firebase service-account JSON.

# Canonical public origin used for absolute social-preview metadata.
NEXT_PUBLIC_SITE_URL=https://mixmag.vercel.app

# --- Firebase Admin SDK (server-only) ---
# From the service-account JSON (Project settings → Service accounts).
FIREBASE_PROJECT_ID=mixmag-6496a
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@mixmag-6496a.iam.gserviceaccount.com
# Keep the surrounding quotes and the literal \n escapes exactly as in the JSON.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Firebase Web SDK (public, shipped to the browser) ---
# From Firebase console → Project settings → Your apps → Web app (</> config).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mixmag-6496a.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=mixmag-6496a
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=mixmag-6496a.firebasestorage.app
# Optional server-only override; defaults to NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET
# or <FIREBASE_PROJECT_ID>.firebasestorage.app.
FIREBASE_STORAGE_BUCKET=

# --- Google Reviews ---
# Public Google review destination. NEXT_PUBLIC variables are set at build time.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/CQhaSTMynPzJEBM/review

# --- Pricing (BCV exchange rate) ---
# Base URL of the companion api-monitor-bcv service (optional; defaults to prod).
BCV_API_URL=https://api-monitor-bcv.vercel.app
# Manual USD->VES fallback rate used when the live feed is down (optional).
EXCHANGE_RATE_FALLBACK_VES=

# --- IAM / operator role ---
# Comma-separated emails that get the operator tier (admin panel access)
# without needing a custom claim. Bootstrap path for the first operator.
OPERATOR_EMAILS=

# AI customer-support demo. Disabled/missing means deterministic zero-token mode.
AI_SUPPORT_ENABLED=false
OPENAI_API_KEY=
AI_SUPPORT_MODEL=gpt-5.6-luna
# At least 24 random characters; required only when AI_SUPPORT_ENABLED=true.
AI_RATE_LIMIT_SECRET=

# --- Zoho CRM (server-only) ---
# Create a Zoho OAuth client and store the server-side credentials here.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Example accounts domain: https://accounts.zoho.com
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
# Example CRM API domain: https://www.zohoapis.com
ZOHO_CRM_API_DOMAIN=https://www.zohoapis.com

# --- Twilio Call Tracking (server-only) ---
# Never expose these values through NEXT_PUBLIC_* variables.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+17372212163
TWILIO_FORWARD_TO_NUMBER=+584143154836
TWILIO_WEBHOOK_BASE_URL=https://example.com
TWILIO_TRIAL_MODE=true
CALL_TRACKING_BUSINESS_ID=default
CALL_TRACKING_TIME_ZONE=America/Caracas

# Public website origins allowed to submit contact leads (no trailing slash).
# For local testing, append http://localhost:8080. CORS is not authentication.
CONTACT_ALLOWED_ORIGINS=https://cirixad.com,https://www.cirixad.com

# Google Business Profile review retrieval (server-only OAuth credentials)
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
